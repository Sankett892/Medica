# Server Environment Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Database (MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/hackmatrix

# Clerk Authentication (Server SDK)
CLERK_SECRET_KEY=sk_test_example_key
CLERK_PUBLISHABLE_KEY=pk_test_example_key

# CORS Settings (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
RATE_LIMIT_AUTH_MAX=50
RATE_LIMIT_QR_MAX=30

# Public Health Analytics (k-anonymity suppression threshold)
ANALYTICS_K_THRESHOLD=5

# Dev Preview Mode (set to 'true' for local testing without active Clerk connection; strictly disabled if NODE_ENV=production)
DEV_PREVIEW=true
